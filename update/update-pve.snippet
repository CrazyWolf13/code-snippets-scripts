# @name: Update: Proxmox VE
# @description: Update a Proxmox instance (PVE-mods updates through its apt repo)
# @os: Debian

apt update && apt install -y screen sudo curl lm-sensors && screen -L -Logfile /root/pve-update.log -S pve-update bash -c 'dpkg --configure -a && apt install -f && apt dist-upgrade && apt autoremove && apt autoclean; N=$(find /boot -maxdepth 1 -name "vmlinuz-*" | sed "s|/boot/vmlinuz-||" | sort -V | tail -n 1); [ "$N" = "$(uname -r)" ] || echo ">>> REBOOT REQUIRED (running $(uname -r), newest $N) <<<"; echo "Update finished: $(date)"; read -rp "Press Enter to close"'
