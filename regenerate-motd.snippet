# @name: Regenerate MOTD
# @description: Recreates the community-scripts LXC details banner and restores the default Debian MOTD
read -e -p "Enter APPLICATION name [$(hostname)]: " APPLICATION; APPLICATION="${APPLICATION:-$(hostname)}"; rm -f /etc/profile.d/00_lxc-details.sh; source <(curl -fsSL https://raw.githubusercontent.com/community-scripts/ProxmoxVE/main/misc/install.func) && motd_ssh; printf '%s\n' 'The programs included with the Debian GNU/Linux system are free software;' 'the exact distribution terms for each program are described in the' 'individual files in /usr/share/doc/*/copyright.' '' 'Debian GNU/Linux comes with ABSOLUTELY NO WARRANTY, to the extent' 'permitted by applicable law.' > /etc/motd; chmod -x /etc/update-motd.d/*
