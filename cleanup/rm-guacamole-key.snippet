# @name: Cleanup: Remove Guacamole key
# @description: Removes the old Guacamole SSH key, only if the Nexterm key is present
F="$HOME/.ssh/authorized_keys"; if grep -qF 'AAAAC3NzaC1lZDI1NTE5AAAAIHQ9vmsolyPNE2tEo+Fry1tRya+I8j7u1iWnP0daEvbx' "$F"; then printf '%s\n' "$(grep -vF 'AAAAC3NzaC1lZDI1NTE5AAAAIOLS6/oYdkVgafkXbNJgthJJAiWFLGQ4cIyIZL/ZhTQZ' "$F")" > "$F"; echo "Guacamole key removed, remaining keys:"; cat "$F"; else echo "Nexterm key not found, nothing removed"; fi
